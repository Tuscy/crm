// Stky platform — single source of truth for apps/web + apps/app

generator client {
  provider      = "prisma-client-js"
  // Vercel / Linux OpenSSL 3 — required for serverless deploy; "native" keeps local dev (e.g. macOS)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  isStaff         Boolean       @default(false)
  // Staff permission tier: ADMIN | EDITOR | VIEWER (see apps/app/lib/permissions.ts).
  // Only meaningful when isStaff is true.
  staffRole       String        @default("ADMIN")
  createdAt       DateTime      @default(now())
  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  assignedTasks   Task[]        @relation("TaskAssignee")
  ownedLeads      Lead[]        @relation("LeadOwner")
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]
  createdInvoices Invoice[]
  siteBuilds      SiteBuild[]
  gbpDraftsCreated  GBPDraft[]  @relation("GBPDraftCreator")
  gbpDraftsApproved GBPDraft[]  @relation("GBPDraftApprover")
}

// Auth.js — forward-compatible (OAuth / database sessions); staff currently uses JWT + Credentials
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Scoped automation keys (hashed at rest). Plain key is shown once at creation.
model IntegrationApiKey {
  id         String    @id @default(cuid())
  name       String?
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]  @default([])
  siteId     String? // binds a tickets:intake key to one site (and so one client)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([siteId])
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  website      String?
  source       String?
  status       String    @default("NEW")
  createdAt    DateTime  @default(now())
  clientId     String?
  siteId       String?
  ownerId      String?
  nextAction   String?
  followUpDate DateTime?

  client     Client?         @relation(fields: [clientId], references: [id])
  site       Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  owner      User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals      Deal[]
  notes      Note[]
  tasks      Task[]
  conversion LeadConversion?

  @@index([status])
  @@index([source])
  @@index([ownerId])
}

model LeadConversion {
  id            String       @id @default(cuid())
  leadId        String       @unique
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  package       PackageType?
  purchaseDate  DateTime?
  agreedDetails String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Deal {
  id          String       @id @default(cuid())
  value       Int?
  stage       String
  leadId      String
  createdAt   DateTime     @default(now())
  closeDate   DateTime?
  probability Int?
  packageType PackageType?
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([stage])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime?
  completed   Boolean   @default(false)
  leadId      String?
  assigneeId  String?
  notes       String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([assigneeId])
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  company   String?
  knownFrom String?
  birthday  DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Client {
  id                   String       @id @default(cuid())
  name                 String
  companyName          String?
  companiesHouseNumber String?      @unique
  industry             String?
  serviceNotes         String?      @map("services")
  primaryContactEmail  String
  contactPhone         String?
  contactAddress       String?
  billingPeriod        String?
  billingPrice         Decimal?     @db.Decimal(12, 2)
  billingCurrency      String?      @default("USD")
  billingNotes         String?
  xeroContactId        String? // set once mapped via Settings → Xero
  sharepointFolderUrl  String? // URL to client's SharePoint document folder
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  package              PackageType?
  services             ClientService[]
  activityLogs         ActivityLog[]
  invoices             Invoice[]
  analyticsCredentials AnalyticsCredential[]
  leads                Lead[]
  memberships          Membership[]
  analytics            AnalyticsConnection[]
  sites                Site[]
  googleAdsConnections GoogleAdsConnection[]
  siteBuilds           SiteBuild[]
  gbpPosts             GBPPost[]
  gbpDrafts            GBPDraft[]
  tickets              Ticket[]

  @@index([xeroContactId])
}

model GoogleAdsSettings {
  id              String   @id @default("default")
  loginCustomerId String
  updatedAt       DateTime @updatedAt
}

model GoogleAdsConnection {
  id                  String    @id @default(cuid())
  clientId            String?
  googleAdsCustomerId String    @unique
  label               String?
  displayName         String?
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model GoogleAdsAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  customerId   String
  operation    String
  payload      Json
  result       Json?
  execute      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

model Site {
  id           String   @id @default(cuid())
  clientId     String
  slug         String?
  customDomain String?  @unique
  subdomain    String?  @unique
  branding     Json?
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages  Page[]
  leads  Lead[]
  tickets Ticket[]
  integrationKeys IntegrationApiKey[]

  @@index([clientId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  slug      String   @default("")
  type      String   @default("MARKETING")
  seo       Json?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  order     Int
  type      String
  content   Json
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model AnalyticsConnection {
  id             String    @id @default(cuid())
  clientId       String
  gaPropertyId   String
  gaAccountEmail String?

  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// --- Phase 1 additions ---

enum ServiceType {
  BRANDING
  WEB
  ADS
}

enum PackageType {
  VOLTAGE
  CHARGE
  GRID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum AnalyticsCredType {
  GA4
  SEARCH_CONSOLE
  GBP
}

model ClientService {
  id        String      @id @default(cuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ServiceType
  active    Boolean     @default(true)
  startedAt DateTime    @default(now())

  @@index([clientId])
}

model GBPDraft {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content       String
  status        String    @default("DRAFT") // DRAFT, APPROVED, POSTED_MOCK
  createdById   String
  createdBy     User      @relation("GBPDraftCreator", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("GBPDraftApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  contentHash   String?   // Hash to detect edits after approval
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([createdById])
  @@index([status])
}

model ActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String
  body      String?
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  lineItems   Json
  subtotal    Float
  vatRate     Float         @default(0.20)
  total       Float
  pdfUrl      String?
  sentAt      DateTime?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
}

model AnalyticsCredential {
  id           String            @id @default(cuid())
  clientId     String?
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type         AnalyticsCredType
  accountId    String
  refreshToken String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([clientId])
  @@unique([clientId, type])
}

/// StickySites' own Xero organisation — connected once, read-only scopes.
/// Xero rotates the refresh token on every refresh, so it is rewritten each time.
model XeroCredential {
  id           String   @id @default(cuid())
  tenantId     String   @unique // Xero's organisation identifier
  tenantName   String?
  refreshToken String // encrypted at rest, same approach as AnalyticsCredential
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Phase 6 additions ---

enum GBPPostType {
  STANDARD
  EVENT
  OFFER
}

/// Local cache of Google Business Profile posts so the UI doesn't re-fetch on every load.
model GBPPost {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  googlePostId String      @unique // GBP localPost resource name
  type         GBPPostType
  summary      String // post body text
  ctaType      String? // CALL, LEARN_MORE, ORDER, SIGN_UP, BUY, etc.
  ctaUrl       String?
  eventTitle   String?
  eventStart   DateTime?
  eventEnd     DateTime?
  offerTitle   String?
  offerCode    String?
  state        String // LIVE | REJECTED | PROCESSING | DELETED
  createTime   DateTime
  updateTime   DateTime
  searchUrl    String?
  syncedAt     DateTime    @default(now())

  @@index([clientId])
}

// --- Phase 5 additions ---

enum ContentMode {
  LOCAL
  SANITY
}

enum SiteBuildStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
  PAUSED
}

model SiteBuild {
  id               String          @id @default(cuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectName      String
  repoName         String?
  figmaUrl         String?
  contentMode      ContentMode     @default(LOCAL)
  sanityProjectId  String?
  sanityDataset    String?
  requiredRoutes   String?
  notes            String?
  status           SiteBuildStatus @default(DRAFT)
  currentStage     Int             @default(0)
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([clientId])
}

// --- Email Flows ---

enum EmailFlowTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  CLIENT_CREATED
  TASK_COMPLETED
  MANUAL
}

enum EmailFlowEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

model EmailFlow {
  id             String               @id @default(cuid())
  name           String
  description    String?
  trigger        EmailFlowTrigger
  triggerConfig  Json? // e.g. { stage: "QUOTED", statusFilter: "NEW" }
  steps          Json // EmailFlowStep[] — the ordered step list
  n8nWorkflowId  String? // numeric ID of the compiled n8n workflow (from n8n REST API)
  n8nWebhookPath String? // UUID path for the n8n webhook trigger — generated by CRM at compile time
  active         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  enrollments    EmailFlowEnrollment[]
}

model EmailFlowEnrollment {
  id              String                    @id @default(cuid())
  flowId          String
  flow            EmailFlow                 @relation(fields: [flowId], references: [id], onDelete: Cascade)
  leadId          String?
  clientId        String?
  status          EmailFlowEnrollmentStatus @default(ACTIVE)
  currentStep     Int                       @default(0)
  enrolledAt      DateTime                  @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  n8nExecutionId  String?
  contactSnapshot Json? // snapshot of lead/client data at enrol time (used for variable substitution)
  sends           EmailFlowSend[]

  @@index([flowId])
  @@index([leadId])
  @@index([clientId])
  @@index([status])
}

model EmailFlowSend {
  id              String              @id @default(cuid())
  enrollmentId    String
  enrollment      EmailFlowEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepIndex       Int
  resendMessageId String? // Resend's ID — used to match incoming webhooks
  subject         String
  sentAt          DateTime            @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  complainedAt    DateTime? // spam report

  @@index([enrollmentId])
  @@index([resendMessageId])
}

model EmailFlowTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  htmlBody  String   @db.Text // rendered HTML from Unlayer editor
  textBody  String?  @db.Text // plain text fallback
  variables String[] // declared variables e.g. ["name", "company", "package"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// General audit trail: who did what to which record, and when. Written by
// apps/app/lib/server/audit.ts for every mutation (and denied attempts).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRole   String?
  action      String   // e.g. "lead.delete", "user.create", "auth.denied"
  entity      String?  // e.g. "Lead"
  entityId    String?
  outcome     String   @default("ALLOWED") // ALLOWED | DENIED
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Ticketing (specs/001-ticketing-and-agent-team). Only the CRM API changes
// Ticket.status (apps/app/lib/tickets/events.ts). TicketEvent is append-only:
// a database trigger (see the tickets migration) rejects UPDATE and direct DELETE.
// ---------------------------------------------------------------------------

enum TicketStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  AWAITING_REVIEW
  AWAITING_CLIENT
  NEEDS_HUMAN
  RESOLVED
  CLOSED
}

enum TicketType {
  SITE_CHANGE
  BUG
  CONTENT
  HOSTING_UPTIME
  SEO_ADS_REPORTING
  BILLING_ADMIN
  INTERNAL
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSource {
  CRM
  PORTAL
  SITE_FORM
  EMAIL
  UPTIME
  AGENT
}

enum TicketActorType {
  CLIENT
  STAFF
  AGENT
  SYSTEM
}

enum TicketAssigneeType {
  NONE
  HUMAN
  AGENT
}

enum TicketVisibility {
  PUBLIC
  INTERNAL
}

model TicketCounter {
  id         Int @id @default(1)
  lastNumber Int @default(0)
}

model Ticket {
  id                    String             @id @default(cuid())
  reference             String             @unique // TKT-0001
  clientId              String
  siteId                String?
  requesterType         TicketActorType
  requesterName         String?
  requesterEmail        String?
  source                TicketSource
  type                  TicketType         @default(OTHER)
  priority              TicketPriority     @default(NORMAL)
  status                TicketStatus       @default(NEW)
  title                 String
  description           String
  assigneeType          TicketAssigneeType @default(NONE)
  assigneeId            String? // staff user id, or agent name
  agentEligible         Boolean            @default(false)
  statusSummary         String? // clean one-line status shown to clients
  finalMessage          String? // plain-English outcome
  shareTechnicalDetails Boolean            @default(false) // staff-only switch: client may see the log
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  resolvedAt            DateTime?

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site     Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  messages TicketMessage[]
  events   TicketEvent[]
  runs     AgentRun[]

  @@index([clientId])
  @@index([siteId])
  @@index([status])
  @@index([createdAt])
}

model TicketMessage {
  id         String           @id @default(cuid())
  ticketId   String
  authorType TicketActorType
  authorName String?
  body       String
  visibility TicketVisibility @default(PUBLIC)
  createdAt  DateTime         @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model AgentRun {
  id           String    @id @default(cuid())
  ticketId     String
  agentName    String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  outcome      String? // SUCCEEDED | FAILED | NEEDS_HUMAN
  prUrl        String?
  previewUrl   String?
  costEstimate Decimal?  @db.Decimal(10, 4)
  rawLogRef    String? // pointer to long output in storage (Phase 6 purges it)

  ticket Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  events TicketEvent[]

  @@index([ticketId])
}

// Append-only activity log. No application code updates or deletes rows.
model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  runId     String?
  seq       Int // per-ticket, starts at 1
  kind      String // e.g. "ticket.created", "status.changed", "agent.step"
  actorType TicketActorType
  actorName String?
  payload   Json?
  createdAt DateTime        @default(now())

  ticket Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  run    AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([ticketId, seq])
  @@index([ticketId, createdAt])
}

// Outbound ticket webhook queue (specs/001-ticketing-and-agent-team/contracts/webhook-events.md).
// Created in the same transaction as the ticket change; the sender and the
// /api/cron/webhook-retries route work through PENDING rows with backoff.
model WebhookDelivery {
  id             String    @id @default(cuid())
  ticketId       String?
  event          String // ticket.created | ticket.message_added | ticket.status_changed | ticket.assigned
  payload        Json
  status         String    @default("PENDING") // PENDING | DELIVERED | DEAD
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([ticketId])
}
