// Stky platform — single source of truth for apps/web + apps/app

generator client {
  provider      = "prisma-client-js"
  // Vercel / Linux OpenSSL 3 — required for serverless deploy; "native" keeps local dev (e.g. macOS)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  isStaff         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  assignedTasks   Task[]        @relation("TaskAssignee")
  activityLogs    ActivityLog[]
  createdInvoices Invoice[]
  siteBuilds      SiteBuild[]
}

// Auth.js — forward-compatible (OAuth / database sessions); staff currently uses JWT + Credentials
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Scoped automation keys (hashed at rest). Plain key is shown once at creation.
model IntegrationApiKey {
  id         String    @id @default(cuid())
  name       String?
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([keyPrefix])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  website   String?
  source    String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  clientId  String?
  siteId    String?

  client     Client?         @relation(fields: [clientId], references: [id])
  site       Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  deals      Deal[]
  notes      Note[]
  tasks      Task[]
  conversion LeadConversion?

  @@index([status])
  @@index([source])
}

model LeadConversion {
  id            String       @id @default(cuid())
  leadId        String       @unique
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  package       PackageType?
  purchaseDate  DateTime?
  agreedDetails String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Deal {
  id          String       @id @default(cuid())
  value       Int?
  stage       String
  leadId      String
  createdAt   DateTime     @default(now())
  closeDate   DateTime?
  probability Int?
  packageType PackageType?
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([stage])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime?
  completed   Boolean   @default(false)
  leadId      String?
  assigneeId  String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([assigneeId])
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  company   String?
  knownFrom String?
  birthday  DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Client {
  id                   String       @id @default(cuid())
  name                 String
  companyName          String?
  companiesHouseNumber String?      @unique
  industry             String?
  serviceNotes         String?      @map("services")
  primaryContactEmail  String
  contactPhone         String?
  contactAddress       String?
  billingPeriod        String?
  billingPrice         Decimal?     @db.Decimal(12, 2)
  billingCurrency      String?      @default("USD")
  billingNotes         String?
  xeroContactId        String? // set once mapped via Settings → Xero
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  package              PackageType?
  services             ClientService[]
  activityLogs         ActivityLog[]
  invoices             Invoice[]
  analyticsCredentials AnalyticsCredential[]
  leads                Lead[]
  memberships          Membership[]
  analytics            AnalyticsConnection[]
  sites                Site[]
  googleAdsConnections GoogleAdsConnection[]
  siteBuilds           SiteBuild[]
  gbpPosts             GBPPost[]

  @@index([xeroContactId])
}

model GoogleAdsSettings {
  id              String   @id @default("default")
  loginCustomerId String
  updatedAt       DateTime @updatedAt
}

model GoogleAdsConnection {
  id                  String    @id @default(cuid())
  clientId            String?
  googleAdsCustomerId String    @unique
  label               String?
  displayName         String?
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model GoogleAdsAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  customerId   String
  operation    String
  payload      Json
  result       Json?
  execute      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

model Site {
  id           String   @id @default(cuid())
  clientId     String
  slug         String?
  customDomain String?  @unique
  subdomain    String?  @unique
  branding     Json?
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages  Page[]
  leads  Lead[]

  @@index([clientId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  slug      String   @default("")
  type      String   @default("MARKETING")
  seo       Json?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  order     Int
  type      String
  content   Json
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model AnalyticsConnection {
  id             String    @id @default(cuid())
  clientId       String
  gaPropertyId   String
  gaAccountEmail String?

  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// --- Phase 1 additions ---

enum ServiceType {
  BRANDING
  WEB
  ADS
}

enum PackageType {
  VOLTAGE
  CHARGE
  GRID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum AnalyticsCredType {
  GA4
  SEARCH_CONSOLE
  GBP
}

model ClientService {
  id        String      @id @default(cuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ServiceType
  active    Boolean     @default(true)
  startedAt DateTime    @default(now())

  @@index([clientId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String
  body      String?
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  lineItems   Json
  subtotal    Float
  vatRate     Float         @default(0.20)
  total       Float
  pdfUrl      String?
  sentAt      DateTime?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
}

model AnalyticsCredential {
  id           String            @id @default(cuid())
  clientId     String?
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type         AnalyticsCredType
  accountId    String
  refreshToken String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([clientId])
  @@unique([clientId, type])
}

/// StickySites' own Xero organisation — connected once, read-only scopes.
/// Xero rotates the refresh token on every refresh, so it is rewritten each time.
model XeroCredential {
  id           String   @id @default(cuid())
  tenantId     String   @unique // Xero's organisation identifier
  tenantName   String?
  refreshToken String // encrypted at rest, same approach as AnalyticsCredential
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Phase 6 additions ---

enum GBPPostType {
  STANDARD
  EVENT
  OFFER
}

/// Local cache of Google Business Profile posts so the UI doesn't re-fetch on every load.
model GBPPost {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  googlePostId String      @unique // GBP localPost resource name
  type         GBPPostType
  summary      String // post body text
  ctaType      String? // CALL, LEARN_MORE, ORDER, SIGN_UP, BUY, etc.
  ctaUrl       String?
  eventTitle   String?
  eventStart   DateTime?
  eventEnd     DateTime?
  offerTitle   String?
  offerCode    String?
  state        String // LIVE | REJECTED | PROCESSING | DELETED
  createTime   DateTime
  updateTime   DateTime
  searchUrl    String?
  syncedAt     DateTime    @default(now())

  @@index([clientId])
}

// --- Phase 5 additions ---

enum ContentMode {
  LOCAL
  SANITY
}

enum SiteBuildStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
  PAUSED
}

model SiteBuild {
  id               String          @id @default(cuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectName      String
  repoName         String?
  figmaUrl         String?
  contentMode      ContentMode     @default(LOCAL)
  sanityProjectId  String?
  sanityDataset    String?
  requiredRoutes   String?
  notes            String?
  status           SiteBuildStatus @default(DRAFT)
  currentStage     Int             @default(0)
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([clientId])
}

// --- Email Flows ---

enum EmailFlowTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  CLIENT_CREATED
  TASK_COMPLETED
  MANUAL
}

enum EmailFlowEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

model EmailFlow {
  id             String               @id @default(cuid())
  name           String
  description    String?
  trigger        EmailFlowTrigger
  triggerConfig  Json? // e.g. { stage: "QUOTED", statusFilter: "NEW" }
  steps          Json // EmailFlowStep[] — the ordered step list
  n8nWorkflowId  String? // numeric ID of the compiled n8n workflow (from n8n REST API)
  n8nWebhookPath String? // UUID path for the n8n webhook trigger — generated by CRM at compile time
  active         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  enrollments    EmailFlowEnrollment[]
}

model EmailFlowEnrollment {
  id              String                    @id @default(cuid())
  flowId          String
  flow            EmailFlow                 @relation(fields: [flowId], references: [id], onDelete: Cascade)
  leadId          String?
  clientId        String?
  status          EmailFlowEnrollmentStatus @default(ACTIVE)
  currentStep     Int                       @default(0)
  enrolledAt      DateTime                  @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  n8nExecutionId  String?
  contactSnapshot Json? // snapshot of lead/client data at enrol time (used for variable substitution)
  sends           EmailFlowSend[]

  @@index([flowId])
  @@index([leadId])
  @@index([clientId])
  @@index([status])
}

model EmailFlowSend {
  id              String              @id @default(cuid())
  enrollmentId    String
  enrollment      EmailFlowEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepIndex       Int
  resendMessageId String? // Resend's ID — used to match incoming webhooks
  subject         String
  sentAt          DateTime            @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  complainedAt    DateTime? // spam report

  @@index([enrollmentId])
  @@index([resendMessageId])
}

model EmailFlowTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  htmlBody  String   @db.Text // rendered HTML from Unlayer editor
  textBody  String?  @db.Text // plain text fallback
  variables String[] // declared variables e.g. ["name", "company", "package"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
