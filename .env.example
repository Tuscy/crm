# =============================================================================
# STKY CRM — Environment Variables
# =============================================================================
# Copy this file to .env (repo root) and fill in real values.
# Sub-packages pull from here via Turborepo env passthrough — do NOT duplicate
# these across apps/app/.env, apps/web/.env, packages/db/.env.
# Only DATABASE_URL needs to be in packages/db/.env for the Prisma CLI.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Neon (or any Postgres). Use the pooler URL for app traffic.
# Run migrations from repo root: pnpm db:migrate
DATABASE_URL="postgresql://user:pass@host:5432/stky?sslmode=require"


# -----------------------------------------------------------------------------
# AUTH (Auth.js / NextAuth)
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# First staff user — created by: pnpm --filter @stky/db exec prisma db seed
STAFF_SEED_EMAIL=""
STAFF_SEED_PASSWORD=""

# Legacy shared-password gate (dev convenience — NOT recommended for production)
STAFF_DASHBOARD_PASSWORD=""
# Set "true" only if you must keep this gate live in production
ALLOW_LEGACY_STAFF_PASSWORD=""


# -----------------------------------------------------------------------------
# URLS
# -----------------------------------------------------------------------------
ROOT_DOMAIN="localhost"
# Optional: pin a specific site when using localhost without DNS
DEV_SITE_ID=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"


# -----------------------------------------------------------------------------
# CRM API + WEBHOOKS
# -----------------------------------------------------------------------------
# REST API key for server-to-server requests (Dashboard → API keys is preferred)
CRM_API_KEY=""

# Outbound webhook (e.g. n8n Webhook node)
CRM_WEBHOOK_URL=""
# HMAC signing secret — generate: openssl rand -hex 32
CRM_WEBHOOK_SECRET=""


# -----------------------------------------------------------------------------
# N8N (self-hosted automation)
# -----------------------------------------------------------------------------
# HTTPS origin, no trailing slash. Used server-side only — never NEXT_PUBLIC_.
N8N_BASE_URL=""
# n8n Settings → API → Create API key
N8N_API_KEY=""


# -----------------------------------------------------------------------------
# UPTIME KUMA (status dots on the dashboard)
# -----------------------------------------------------------------------------
# HTTPS origin of your Kuma instance, no trailing slash. Server-side only.
UPTIME_KUMA_BASE_URL=""
# Slug of a published Kuma status page that contains the monitors to show
# (Kuma → Status Pages → the part after /status/).
UPTIME_KUMA_STATUS_SLUG=""


# -----------------------------------------------------------------------------
# EMAIL FLOWS (drip sequences compiled to n8n + sent via Resend)
# -----------------------------------------------------------------------------
# Public origin of THIS CRM, no trailing slash — n8n calls back here after each
# flow step. Falls back to NEXTAUTH_URL / AUTH_URL if unset.
CRM_BASE_URL="http://localhost:3000"
# Shared secret sent by n8n on the internal step-complete callback. Generate:
# openssl rand -base64 32
EMAIL_FLOWS_INTERNAL_SECRET=""
# Resend webhook signing secret (Resend dashboard → Webhooks). Starts "whsec_".
# Endpoint: https://<crm-domain>/api/email-flows/webhooks/resend
# If unset, webhook signature verification is skipped (dev only).
RESEND_WEBHOOK_SECRET=""


# -----------------------------------------------------------------------------
# REDIS (rate limiting + magic-link abuse protection)
# -----------------------------------------------------------------------------
# Create a free Redis at https://upstash.com — copy the REST URL + token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# -----------------------------------------------------------------------------
# EMAIL (magic links + client notifications)
# -----------------------------------------------------------------------------
# https://resend.com — API key from dashboard
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@stkysites.com"


# -----------------------------------------------------------------------------
# COMPANIES HOUSE
# -----------------------------------------------------------------------------
# Used for "Add Client" company lookup in the staff CRM (server-only).
# Register at: https://developer.company-information.service.gov.uk/
# Create a REST API key — no OAuth needed for read-only public data.
COMPANIES_HOUSE_API_KEY=""


# -----------------------------------------------------------------------------
# GOOGLE OAUTH (shared client — covers GA4, Search Console, Ads)
# -----------------------------------------------------------------------------
# One OAuth 2.0 client can cover all Google APIs by requesting all scopes
# at the consent screen in one go:
#   https://www.googleapis.com/auth/analytics.readonly
#   https://www.googleapis.com/auth/webmasters.readonly
#   https://www.googleapis.com/auth/adwords
#
# Console: https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth 2.0 Client ID (Web application)
# Authorised redirect URI: https://your-domain/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URL="http://localhost:3000/api/oauth/google/callback"

# Per-account refresh tokens are stored encrypted in the AnalyticsCredential
# table. ENCRYPTION_KEY provides AES-256-GCM at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# Google Business Profile — uses GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
# Requires business.manage scope. Apply for GBP API access first:
# https://developers.google.com/my-business/content/prereqs


# -----------------------------------------------------------------------------
# XERO (read-only — invoices, contacts, bank transactions)
# -----------------------------------------------------------------------------
# Register at: https://developer.xero.com/myapps → Web app
# Granular scopes requested at connect time: offline_access,
# accounting.contacts.read, accounting.invoices.read,
# accounting.banktransactions.read — see docs/plans/xero-and-crm-updates.md
# Authorised redirect URI: https://your-domain/api/oauth/xero/callback
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_OAUTH_REDIRECT_URL="http://localhost:3000/api/oauth/xero/callback"

# From the same app's Webhooks tab — set the delivery URL there
# (https://your-domain/api/webhooks/xero) and Xero generates this key.
# Xero sends a validation POST to that URL when you save it, so the receiver
# route needs to exist and respond correctly before this is confirmed
# working — order this after the webhook route is built, not before.
# HMAC-SHA256 signature check, see docs/plans/xero-and-crm-updates.md Part A.
XERO_WEBHOOK_SIGNING_KEY=""


# -----------------------------------------------------------------------------
# GOOGLE ADS API (agency MCC account)
# -----------------------------------------------------------------------------
# Full setup guide: CRM/docs/google-ads.md
# Credentials also live in google-ads/config/google-ads.yaml (used by Python
# scripts directly). Keep both in sync.
#
# Developer token: https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Can reuse the same OAuth client as GOOGLE_CLIENT_ID above
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
# Refresh token scoped to https://www.googleapis.com/auth/adwords
GOOGLE_ADS_REFRESH_TOKEN=""
# MCC (manager) account ID — digits only, no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Python write-bridge paths — update to match your local machine
GOOGLE_ADS_PYTHON_BIN="/Users/Rhyse/Desktop/StkySites/Software/google-ads/scripts/python/.venv/bin/python3"
GOOGLE_ADS_SCRIPTS_ROOT="/Users/Rhyse/Desktop/StkySites/Software/google-ads/scripts/python"


# -----------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE API
# -----------------------------------------------------------------------------
# Uses the same OAuth client as Google Ads / GA4 above.
# The refresh token must include scope: https://www.googleapis.com/auth/webmasters.readonly
# If you obtained a combined refresh token (all scopes at once) it works here too.
#
# Site URL exactly as registered in Search Console, e.g.:
#   sc-domain:stkysites.co.uk   (domain property)
#   https://www.stkysites.co.uk/ (URL-prefix property — trailing slash required)
GOOGLE_SEARCH_CONSOLE_SITE_URL=""
# Only needed if using a separate refresh token for Search Console
# GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=""


# -----------------------------------------------------------------------------
# OPTIONAL / FUTURE
# -----------------------------------------------------------------------------
# Sentry (production error reporting — wire @sentry/nextjs in app if used)
# SENTRY_DSN=""

# CSP report-only mode (log violations without enforcing — useful when rolling out)
# CSP_REPORT_ONLY="true"
