    {
      "id": "verify-signature",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Verify the CRM's HMAC before anything else. Drop failures.\nconst crypto = require('crypto');\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst header = ($input.first().json.headers || {})['x-stky-signature'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.TICKET_WEBHOOK_SECRET).update(raw).digest('hex');\nconst a = Buffer.from(header), b = Buffer.from(expected);\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\nreturn [{ json: { valid, payload: valid ? JSON.parse(raw) : null } }];"
      }
    },
    {
      "id": "signature-valid?",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v",
              "leftValue": "={{$json.valid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "respond-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true} }}",
        "options": {
          "responseCode": 200
        }
      }
    },
