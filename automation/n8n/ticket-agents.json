      "parameters": {
        "jsCode": "// Repo registry: siteId -> owner/name. Fill from ops/registry. Unknown sites go to a person.\nconst REPO_MAP = {\n  // \"cl_site_id_here\": \"StickySites/example-client-site\",\n};\nconst { ticket, data } = $input.first().json;\nconst repo = REPO_MAP[ticket.siteId] || null;\nreturn [{ json: { ticket, repo, brief: (data.summary || '').slice(0, 300) } }];"
