    {
      "id": "verify-and-filter-pr",
      "name": "Verify and filter PR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        700
      ],
      "parameters": {
        "jsCode": "// Verify GitHub's signature, then only act on merged PRs from claude/tkt-* branches.\nconst crypto = require('crypto');\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst header = ($input.first().json.headers || {})['x-hub-signature-256'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.GITHUB_WEBHOOK_SECRET).update(raw).digest('hex');\nconst a = Buffer.from(header), b = Buffer.from(expected);\nif (!(a.length === b.length && crypto.timingSafeEqual(a, b))) return [];\nconst p = JSON.parse(raw);\nconst ref = (p.pull_request && p.pull_request.head && p.pull_request.head.ref) || '';\nconst m = /^claude\\/(tkt-\\d+)/i.exec(ref);\nif (p.action !== 'closed' || !(p.pull_request && p.pull_request.merged) || !m) return [];\nreturn [{ json: { reference: m[1].toUpperCase() } }];"
      }
    },
    {
