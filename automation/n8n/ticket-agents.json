    {
      "id": "validate-triage",
      "name": "Validate triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -200
      ],
      "parameters": {
        "jsCode": "// Strict validation: anything unexpected becomes NEEDS_HUMAN, never a guess.\nconst ticket = $('Build triage prompt').first().json.ticket;\nconst TYPES = ['SITE_CHANGE','BUG','CONTENT','HOSTING_UPTIME','SEO_ADS_REPORTING','BILLING_ADMIN','INTERNAL','OTHER'];\nconst PRI = ['LOW','NORMAL','HIGH','URGENT'];\nlet r = null;\ntry { const text = $input.first().json.content[0].text; r = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1)); } catch (e) {}\nconst ok = !!r && TYPES.includes(r.type) && PRI.includes(r.priority) && typeof r.agentEligible === 'boolean'\n  && typeof r.statusSummary === 'string' && r.statusSummary.length > 0 && r.statusSummary.length <= 300\n  && typeof r.acknowledgement === 'string' && r.acknowledgement.length > 0 && (r.flag === null || typeof r.flag === 'string');\nconst eligible = ok && r.agentEligible && ['SITE_CHANGE','BUG','CONTENT'].includes(r.type);\nreturn [{ json: { ok, ticket, result: ok ? r : null, flagged: ok && r.flag !== null, eligible } }];"
      }
    },
